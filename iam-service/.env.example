# Copy this file to .env for local development.
# In the cluster, these values come from K8s Secrets and ConfigMaps — this file is never deployed.

DATABASE_URL=postgresql+asyncpg://iam_user:iam_pass@localhost:5432/iam_db
JWT_SECRET_KEY=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
BCRYPT_ROUNDS=12
APP_HOST=0.0.0.0
APP_PORT=8001
