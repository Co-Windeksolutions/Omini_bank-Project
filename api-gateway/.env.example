WALLET_SERVICE_URL=http://localhost:8002
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_LOGIN=20/minute
HTTP_TIMEOUT=10.0
APP_HOST=0.0.0.0
APP_PORT=8000
