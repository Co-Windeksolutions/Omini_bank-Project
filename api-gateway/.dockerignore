# --- Secrets & local config ---
.env
.env.*
!.env.example

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Python bytecode ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Build & dist artifacts ---
*.egg-info/
dist/
build/
*.egg

# --- Test & tooling ---
.pytest_cache/
.coverage
htmlcov/
tests/
# Note on excluding tests/:
# Tests are not needed at runtime and excluding them keeps the image smaller.
# The tradeoff: you cannot run pytest inside the container without rebuilding
# with a dev target. For this project that is acceptable — tests run in CI
# before the image is built, not inside the deployed image.

# --- Editor / OS noise ---
.DS_Store
*.swp
*.swo
.idea/
.vscode/
